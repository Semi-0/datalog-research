(define source 1)
(define increment (network [x] (+ x 1)))
(define result (increment source))
(define references (let-cell [out] (propagator-references result :inputs out)))
(define hierarchy-view (let-cell [out] (hierarchy references out)))
(define value-view (let-cell [out] (cell-window result out)))
(define history-view (let-cell [out] (cell-history result out)))
(define dashboard
  (let-cell [out]
    (juxtapose value-view hierarchy-view history-view out)))
(xr:io dashboard)
