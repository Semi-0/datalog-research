;; Inspect the constructor's internal protocol network with the existing tracer.
;; Policy/accessor bodies may remain partial; no live I/O is bound.
(load-lain "propagators/compiler_2/runtime/lain/tracers.lain")
(load-lain "examples/lain/subagents/evaluation-framework.lain")

(define harbor (make-harbor))
(define evaluation-framework (evaluation-framework-from-harbor harbor))

(display (trace:children evaluation-framework))
