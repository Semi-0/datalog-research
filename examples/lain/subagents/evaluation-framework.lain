;; Public endpoints are compound objects; internal relationships name their cells.
;; Primitive policy bodies arrive by session extension, without live I/O here.
(load-lain "propagators/compiler_2/runtime/lain/combinator.lain")

;; Framework interface used by the grand orchestrator.
(define assignments (slot :assignments))
(define on-going-assignment (slot :on-going-assignment))
(define assignment-result (slot :assignment-result))
(define evaluation:harbor (slot :harbor))

;; Harbor transport interface: request facts leave, observations arrive.
(define harbor:requests (slot :requests))
(define harbor:observations (slot :observations))
(define make-harbor
  (network []
    (let-cell [requests observations]
      (struct :requests requests :observations observations))))

;; Pure policies supplied by the session extension. Handlers outside this network
;; execute requests, return observations, and own receipts and process cleanup.
(define harbor:observe-context)
(define harbor:observe-assessment)
(define harbor:prepare)
(define harbor:grade)
(define evaluation:assignment-trials)
(define evaluation:assessment-updates)
(define evaluation:trial-execution)
(define evaluation:runnable-assignments)

(define harbor:trial-contexts
  (network [trials observations]
    (harbor:observe-context trials observations)
    (list trials)))

(define harbor:trial-assessments
  (network [trials observations]
    (define assessments)
    (harbor:observe-assessment trials observations assessments)
    assessments))

(define harbor:preparation-requests
  (network [shared-assignments trials]
    (define requests)
    (harbor:prepare shared-assignments trials requests)
    requests))

(define harbor:grading-requests
  (network [trials assessments]
    (define requests)
    (harbor:grade trials assessments requests)
    requests))

;; Assignments are shared facts with stable IDs, user order, and evaluation results.
;; Results enrich the matching assignment; they never replace the user's order.
(define evaluation:assignment-protocol
  (network [shared-assignments trials assessments]
    (evaluation:assignment-trials shared-assignments trials)
    (-> (evaluation:assessment-updates trials assessments) shared-assignments)
    (list shared-assignments trials assessments)))

;; Assignment results arrive from the runner through the assignment-result port.
;; Those results enrich trial execution facts; user priority constrains pending work.
;; Reordering changes pending priority only; already-running work continues.
;; Pi owns child lifecycle. The ongoing output is derived, not another queue.
(define evaluation:execution-protocol
  (network [shared-assignments trials runtime-results ongoing-assignment]
    (evaluation:trial-execution trials runtime-results)
    (-> (evaluation:runnable-assignments shared-assignments trials) ongoing-assignment)
    (list trials ongoing-assignment)))

(define evaluation:assessment-protocol
  (network [trials framework-observations assessments]
    (harbor:trial-contexts trials framework-observations)
    (-> (harbor:trial-assessments trials framework-observations) assessments)
    (list trials assessments)))

;; Preparation respects current assignment order. Grading follows execution
;; evidence. Request identity is independent of priority, so reordering cannot
;; relaunch acknowledged work. Outside handlers reconcile uncertain launches.
(define evaluation:external-protocol
  (network [shared-assignments trials assessments framework-requests]
    (-> (harbor:preparation-requests shared-assignments trials) framework-requests)
    (-> (harbor:grading-requests trials assessments) framework-requests)
    (list framework-requests)))

;; The constructor exposes the complete wiring. Trials and assessments are
;; internal cells. The returned framework exposes only its orchestration ports
;; and a distinct Harbor transport endpoint; no provider must invent its slots.
(define make-evaluation-framework
  (network []
    (let-cell [shared-assignments ongoing-assignment runtime-results
               trials assessments]
      (define harbor (make-harbor))
      (evaluation:assignment-protocol shared-assignments trials assessments)
      (evaluation:execution-protocol shared-assignments trials
                                     runtime-results ongoing-assignment)
      (evaluation:assessment-protocol trials (harbor:observations harbor) assessments)
      (evaluation:external-protocol shared-assignments trials
                                    assessments (harbor:requests harbor))
      (struct :assignments shared-assignments
              :on-going-assignment ongoing-assignment
              :assignment-result runtime-results
              :harbor harbor))))
