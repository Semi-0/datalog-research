;; Evaluation framework: a persistent network of simultaneous relations.
;; There is no execution order between the relations composed by the constructor.
;; Accessor storage and policy bodies remain partial for later session extension.

;; Public actor accessors. Their slot-backed implementations must preserve partial
;; fields and connect cells bidirectionally without unwrapping the actor value.
(define assignments)
(define on-going-assignment)
(define assignment-result)
(define evaluation:specification)
(define evaluation:observations)
(define evaluation:requests)
(define evaluation:trials)
(define evaluation:assessments)

;; Pure policy interfaces. Requests are data for outside Harbor handlers;
;; preparation and grading observations return through evaluation:observations.
(define evaluation:preparation-demand)
(define evaluation:trial-contexts)
(define evaluation:eligible-work)
(define evaluation:execution-evidence)
(define evaluation:grading-demand)
(define evaluation:assessment-facts)
(define evaluation:assignment-updates)
(define evaluation:request-facts)

;; The public actor and its internal cells describe the same information.
(define evaluation:interface
  (network [actor assignment-facts runnable-work runtime-observations
            specification framework-observations framework-requests trials assessments]
    (assignments actor assignment-facts)
    (on-going-assignment actor runnable-work)
    (assignment-result actor runtime-observations)
    (evaluation:specification actor specification)
    (evaluation:observations actor framework-observations)
    (evaluation:requests actor framework-requests)
    (evaluation:trials actor trials)
    (evaluation:assessments actor assessments)
    (list actor)))

;; Trial contexts are constrained by assignment facts, the specification and
;; observations of prepared trials. Missing contexts create preparation demand.
(define evaluation:trial-relation
  (network [specification assignment-facts framework-observations trials preparation-requests]
    (evaluation:preparation-demand specification assignment-facts framework-observations preparation-requests)
    (evaluation:trial-contexts specification assignment-facts framework-observations trials)
    (list trials preparation-requests)))

;; Runnable work and execution evidence are views of the same assignments,
;; trial contexts and Pi observations. Pi retains ownership of child lifecycle.
(define evaluation:execution-relation
  (network [assignment-facts trials runtime-observations runnable-work evidence]
    (evaluation:eligible-work assignment-facts trials runtime-observations runnable-work)
    (evaluation:execution-evidence trials runtime-observations evidence)
    (list runnable-work evidence)))

;; Evidence constrains grading demand; evaluator observations constrain the
;; assessments. No grader or model is invoked by these relations.
(define evaluation:assessment-relation
  (network [specification trials evidence framework-observations grading-requests assessments]
    (evaluation:grading-demand specification trials evidence framework-observations grading-requests)
    (evaluation:assessment-facts specification trials evidence framework-observations assessments)
    (list grading-requests assessments)))

;; Progress and graded outcomes contribute facts to the shared assignments.
;; Policy must preserve assignment/trial/run identity and emit stable facts:
;; reevaluation cannot mint new events, duplicate requests or erase old evidence.
(define evaluation:assignment-relation
  (network [assignment-facts trials evidence assessments updates]
    (evaluation:assignment-updates assignment-facts trials evidence assessments updates)
    (list updates)))

;; Preparation and grading demands share one external request interface.
(define evaluation:request-relation
  (network [preparation-requests grading-requests framework-requests]
    (evaluation:request-facts preparation-requests grading-requests framework-requests)
    (list framework-requests)))

;; Each construction has fresh internal cells. Source facts are distinct from
;; derived views; the feedback edge contributes monotonic assignment updates.
;; Only this constructor composes the internal networks; it performs no I/O.
(define make-evaluation-framework
  (network [actor]
    (let-cell [assignment-facts specification runtime-observations framework-observations
               trials runnable-work evidence assessments
               preparation-requests grading-requests framework-requests updates]
      (evaluation:interface actor assignment-facts runnable-work runtime-observations
                            specification framework-observations framework-requests trials assessments)
      (evaluation:trial-relation specification assignment-facts framework-observations trials preparation-requests)
      (evaluation:execution-relation assignment-facts trials runtime-observations runnable-work evidence)
      (evaluation:assessment-relation specification trials evidence framework-observations grading-requests assessments)
      (evaluation:assignment-relation assignment-facts trials evidence assessments updates)
      (evaluation:request-relation preparation-requests grading-requests framework-requests)
      (-> updates assignment-facts))
    (list actor)))
