;; Construct a partial interface; compose the relationships that maintain it.
;; Policy primitives remain partial. Outside interpreters own all live effects.
(load-lain "propagators/compiler_2/runtime/lain/combinator.lain")

;; The orchestrator connects these three ports. Results come from the runner,
;; not directly from Harbor observations; graded outcomes enrich assignments.
(define assignments (slot :assignments))
(define on-going-assignment (slot :on-going-assignment))
(define assignment-result (slot :assignment-result))

(define make-evaluation-framework
  (network []
    (let-cell [assignment-facts ongoing runner-results]
      (struct :assignments assignment-facts
              :on-going-assignment ongoing
              :assignment-result runner-results))))

;; Harbor is an independently injected request/observation interface.
(define harbor:requests (slot :requests))
(define harbor:observations (slot :observations))
(define make-harbor
  (network []
    (let-cell [requests observations]
      (struct :requests requests :observations observations))))

;; A session extension supplies pure policy/translation propagators.
;; These declarations do not bind a bridge, run Pi, or invoke Harbor.
(define evaluation:derive-trials)
(define evaluation:incorporate-results)
(define evaluation:select-pending-assignment)
(define evaluation:derive-assignment-updates)
(define harbor:observe-context)
(define harbor:observe-assessment)
(define harbor:prepare)
(define harbor:grade)

;; Expose the requested fact directly, rather than wrapping it in a list.
(define harbor:request-preparation
  (network [assignment-facts trials]
    (let-cell [requests]
      (harbor:prepare assignment-facts trials requests)
      requests)))

(define harbor:request-grading
  (network [trials assessments]
    (let-cell [requests]
      (harbor:grade trials assessments requests)
      requests)))

(define harbor:derive-assessments
  (network [trials observations]
    (let-cell [assessments]
      (harbor:observe-assessment trials observations assessments)
      assessments)))

;; Trial plans and runner completions contribute facts to the same trial cell.
;; The installed policies must merge facts by stable assignment/event IDs.
(define evaluation:maintain-trials
  (network [assignment-facts runner-results trials]
    (evaluation:derive-trials assignment-facts trials)
    (evaluation:incorporate-results trials runner-results trials)
    (list assignment-facts runner-results trials)))

;; Inject Harbor once; the returned relationship takes only the cells it relates.
;; Requests and observations coexist, rather than defining workflow steps.
(define harbor:prepare-with
  (network [harbor]
    (network [assignment-facts trials]
      (-> (harbor:request-preparation assignment-facts trials)
          (harbor:requests harbor))
      (harbor:observe-context trials (harbor:observations harbor) trials)
      (list assignment-facts trials))))

(define harbor:assess-with
  (network [harbor]
    (network [trials assessments]
      (-> (harbor:request-grading trials assessments)
          (harbor:requests harbor))
      (-> (harbor:derive-assessments trials (harbor:observations harbor))
          assessments)
      (list trials assessments))))

;; Composition chooses the dependency; construction only exposes the interface.
;; Only trials and assessments are additional shared internal endpoints.
(define evaluation-framework-from-harbor
  (network [harbor]
    (let [framework (make-evaluation-framework)]
      (let-cell [trials assessments]
        (evaluation:maintain-trials
          (assignments framework) (assignment-result framework) trials)
        ((harbor:prepare-with harbor) (assignments framework) trials)
        ((harbor:assess-with harbor) trials assessments)

        ;; Select pending work in user order; retain already-running work.
        ;; This is a derived offer, not a second mutable runtime queue.
        (-> (evaluation:select-pending-assignment (assignments framework) trials)
            (on-going-assignment framework))

        ;; Stable-ID graded outcomes enrich the original assignment facts.
        ;; Feedback preserves user order; reordering affects pending work only.
        (-> (evaluation:derive-assignment-updates trials assessments)
            (assignments framework))
        framework))))
