;; The evaluation framework constructs a fresh actor without configuration inputs.
;; Its protocol relations coexist; textual order is not a workflow schedule.
;; Slot storage and pure policy bodies remain open to session extension.

;; Public protocol ports. Accessors connect partial cells without unwrapping the
;; whole actor. The current assignment is a derived output, not another task queue.
(define assignments)
(define on-going-assignment)
(define assignment-result)
(define evaluation:observations)
(define evaluation:requests)
(define evaluation:trials)
(define evaluation:assessments)

;; Deferred constraints over shared assignment, trial and assessment information.
(define evaluation:assignment-trials)
(define evaluation:assessment-updates)
(define evaluation:trial-execution)
(define evaluation:runnable-assignments)
(define evaluation:trial-contexts)
(define evaluation:trial-assessments)
(define evaluation:required-actions)

;; Assignment facts constrain trials; assessments contribute assignment outcomes.
;; Updates retain stable assignment/trial/run identities and merge monotonically.
(define evaluation:assignment-protocol
  (network [shared-assignments trials assessments]
    (let-cell [updates]
      (evaluation:assignment-trials shared-assignments trials)
      (evaluation:assessment-updates trials assessments updates)
      (-> updates shared-assignments))
    (list shared-assignments trials)))

;; Runtime observations constrain trial evidence. Eligible work is a view of the
;; same assignments/trials, exposed through the ongoing-assignment protocol cell.
;; Pi owns child lifecycle; this relation does not synchronize a second FSM.
(define evaluation:execution-protocol
  (network [shared-assignments trials runtime-observations ongoing-assignment]
    (evaluation:trial-execution trials runtime-observations)
    (evaluation:runnable-assignments shared-assignments trials ongoing-assignment)
    (list trials ongoing-assignment)))

;; Harbor observations constrain trial contexts and assessments.
(define evaluation:assessment-protocol
  (network [trials framework-observations assessments]
    (evaluation:trial-contexts trials framework-observations)
    (evaluation:trial-assessments trials framework-observations assessments)
    (list trials assessments)))

;; Preparation/grading requests are derived protocol facts for outside handlers.
;; Demand requires positive evidence; an unresolved observation is not failure.
;; Stable effect identities/receipts prevent reevaluation from repeating effects.
(define evaluation:external-protocol
  (network [shared-assignments trials assessments framework-requests]
    (evaluation:required-actions shared-assignments trials assessments framework-requests)
    (list framework-requests)))

;; Actor is a locally constructed output, never an input. Every construction has
;; fresh protocol cells; only this constructor composes the internal networks.
(define make-evaluation-framework
  (network []
    (define actor)
    (let-cell [shared-assignments ongoing-assignment trials assessments
               runtime-observations framework-observations framework-requests]
      (assignments actor shared-assignments)
      (on-going-assignment actor ongoing-assignment)
      (assignment-result actor runtime-observations)
      (evaluation:observations actor framework-observations)
      (evaluation:requests actor framework-requests)
      (evaluation:trials actor trials)
      (evaluation:assessments actor assessments)

      (evaluation:assignment-protocol shared-assignments trials assessments)
      (evaluation:execution-protocol shared-assignments trials runtime-observations ongoing-assignment)
      (evaluation:assessment-protocol trials framework-observations assessments)
      (evaluation:external-protocol shared-assignments trials assessments framework-requests))
    (list actor)))
