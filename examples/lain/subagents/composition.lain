;; Three actors connected by concurrent relations. Constructors expose partial
;; interfaces; session extensions supply policies and outside interpreters.
(load-lain "propagators/compiler_2/runtime/lain/tracers.lain")
(load-lain "examples/lain/subagents/evaluation-framework.lain")
(load-lain "examples/lain/subagents/user-socket.lain")
(load-lain "examples/lain/subagents/runtime-pi.lain")

(define socket (make-socket))
(define pi (make-pi))
(define harbor (make-harbor))
(define user (user-from-socket socket))
(define runtime (runtime-from-pi pi))
(define evaluation-framework (evaluation-framework-from-harbor harbor))

(<-> (assignments user)
     (assignments evaluation-framework))

(-> (on-going-assignment evaluation-framework)
    (execute-assignment runtime))

(-> (assignment-result runtime)
    (assignment-result evaluation-framework))

(-> (user:controls user) (runtime:controls runtime))
(-> (runtime:status runtime) (user:feedback user))

;; Claims and active execution are scheduling facts too. Keep this progress path
;; distinct from the terminal assignment-result port so pending reorder cannot
;; replace already-claimed/running work.
(-> (runtime:status runtime) (assignments evaluation-framework))

;; Evaluation outcomes return through shared assignments; runtime status returns
;; through feedback. Socket, Harbor and Pi effects remain outside this network.
;; Display only the three semantic actors. Adapter and primitive nodes stay hidden;
;; projected edges retain the connections through those internal nodes.
(display
  (trace:history-latest
    (trace:with-values
      (trace:high-level
        (trace:roots user)
        "user" "evaluation-framework" "runtime"))
    10))
