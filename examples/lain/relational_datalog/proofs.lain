;; Each invocation has its own shared middle-variable cell.
;; Dependencies are conjunctive within a proof, alternative between proofs.
(let []
  (define join-path (network (left right) (unify-path left right)))
  (define via-b (join-path ab bc))
  (define via-d (join-path ad dc))
  (define rejected (join-path ab dc))
  (proof-relation via-b via-d rejected))
