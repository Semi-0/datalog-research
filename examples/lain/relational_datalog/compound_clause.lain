;; Compound fields are read-only observations; each join has private bindings.
(let []
  (define join-path (network (left right)
    (unify-path
          (edge-pair (from left) (to left))
          (edge-pair (from right) (to right)))))
  (define via-b (join-path ab bc))
  (define via-d (join-path ad dc))
  (define rejected (join-path ab dc))
  (proof-relation via-b via-d rejected))
