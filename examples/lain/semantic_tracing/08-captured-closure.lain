(load-lain
  "propagators/compiler_2/runtime/lain/semantic_traversal.lain")

; captured bias: 15
(define make-adder
  (network [bias]
    (network [x]
      (+ x bias))))

(define add-ten (make-adder 10))
(define input 5)
(def-cells result)

(-> (add-ten input) result)

(display
  (observe-dependents-retained input))
