;; Lain-first specification; the renderer interprets its stack result separately.
;; import is an ordinary alias of the existing project-relative file loader.
;; Imports share this program environment; order is explicit, with no module cache.
(define import load-lain)
(import "examples/lain/top_down/stack/structure.lain")
(import "examples/lain/top_down/stack/constraints.lain")
(import "examples/lain/top_down/stack/traversal-state.lain")
(import "examples/lain/top_down/stack/hierarchy.lain")
(import "examples/lain/top_down/stack/fixtures.lain")
(import "examples/lain/top_down/stack/example.lain")

(define stack-specification-revision :stack-spec-2026-10-20-r9)

;; High-level orchestration stays in Lain; imported domains own their contracts.
;; Capture is real. Pending and concrete implementations occupy separately
;; versioned blocks in the incremental experiment.
(define captured (observe-semantic-captured example-result :both))
(define selected-compound (root-compound-node captured))
(define stacks (compound->stack captured selected-compound))
(define checks (stack-constraints captured stacks))
(define design
  (list
    (list :example-result example-result)
    (list :specification-revision stack-specification-revision)
    (list :fixture-expectations stack-fixture-expectations)
    (list :data stacks)
    (list :constraints checks)))

;; Review this data independently from its spatial interpretation.
;; One occurrence graph occupies each plane; primitives stay within that plane.
;; Expansions connect their source compound node to a lower canonical plane or
;; an explicit reference; they do not add semantic dataflow edges.
;; Acquire missing scope information only from the original observation.
;; Camera, depth visibility and layer spacing are view state, not struct fields.
(display design)
