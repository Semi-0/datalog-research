;; Separately versioned implementation definitions for stack-spec-2026-10-20-r9.
;; Single-result operations use implicit results. This block supplies only
;; generic struct construction and pure frozen-capture readers.
(define struct (network [fields] (stack:struct fields)))
(define stack-slot (network [field value] (stack.raw:stack-slot field value)))
(define root-compound-node
  (network [observation] (stack.raw:root-compound-node observation)))
(define compound-occurrence
  (network [observation compound-node]
    (stack.raw:compound-occurrence observation compound-node)))
(define occurrence-identity
  (network [observation occurrence]
    (stack.raw:occurrence-identity observation occurrence)))
(define content-of-scope
  (network [observation occurrence]
    (stack.raw:content-of-scope observation occurrence)))
(define direct-compound-expansions
  (network [observation occurrence]
    (stack.raw:direct-compound-expansions observation occurrence)))
(define stack-shape? (network [value] (stack.raw:stack-shape? value)))
(define scope-content?
  (network [observation identity content]
    (stack.raw:scope-content? observation identity content)))
(define direct-expansions?
  (network [observation identity expansions]
    (stack.raw:direct-expansions? observation identity expansions)))
(define reference-integrity?
  (network [value] (stack.raw:reference-integrity? value)))
