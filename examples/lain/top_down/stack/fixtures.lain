    (list :distinct-calls :satisfied (list :complete-roots :complete-children))
    (list :sibling-sharing :satisfied (list :complete-roots :complete-children))
    (list :reference-cycle :satisfied (list :complete-roots :complete-children))
    (list :deep-tail-expansion :satisfied (list :complete-roots :complete-children))
