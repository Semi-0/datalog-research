;; Separately versioned bindings for generic compound traversal-state mechanics.
;; The tail-recursive loop, discovery decision, reference policy, and frozen
;; observation orchestration remain in hierarchy.lain.

(define begin-traversal
  (network [observation root]
    (stack.raw:begin-traversal observation root)))
(define traversal-empty?
  (network [state] (stack.raw:traversal-empty? state)))
(define take-pending
  (network [state] (stack.raw:take-pending state)))
(define pending-work
  (network [step] (stack.raw:pending-work step)))
(define pending-remaining
  (network [step] (stack.raw:pending-remaining step)))
(define pending-occurrence
  (network [work] (stack.raw:pending-occurrence work)))
(define discovered-occurrence?
  (network [state identity]
    (stack.raw:discovered-occurrence? state identity)))
(define register-occurrence
  (network [state work identity content]
    (stack.raw:register-occurrence state work identity content)))
(define connect-reference
  (network [state work reference]
    (stack.raw:connect-reference state work reference)))
(define connect-expansion-outputs
  (network [state identity expansions]
    (stack.raw:connect-expansion-outputs state identity expansions)))
(define enqueue-expansion-work
  (network [state identity expansions]
    (stack.raw:enqueue-expansion-work state identity expansions)))
(define finish-traversal
  (network [state] (stack.raw:finish-traversal state)))
(define traversal-result
  (network [state] (stack.raw:traversal-result state)))
