;; Proposed named-field struct contract, not a successful implementation stub.
;; Known fields must remain readable while other fields are missing.
;; Equal field evidence is idempotent; incompatible evidence conflicts locally.
;; Later field refinements must reach existing p:slot readers.
;; `struct` and `stack-slot` are versioned definitions owned by the dedicated
;; implementation slot. Single-result operations use Lain's implicit result;
;; callers never allocate or pass an output cell for a domain value.

;; A stack plane is the graph produced by expanding one compound occurrence.
;; Expansion entries retain the node in this plane that expands to another plane.
;; Empty means known complete and empty; unavailable expansions remain missing.
(define stack
  (network [identity graph expansions]
    (struct
      (list
        (list :type :stack)
        (list :identity identity)
        (list :graph graph)
        (list :expansions expansions)))))

(define stack-expansion
  (network [source target]
    (struct
      (list
        (list :type :stack-expansion)
        (list :source source)
        (list :target target)))))

(define stack-ref
  (network [identity]
    (struct
      (list
        (list :type :stack-ref)
        (list :identity identity)))))

(define stack-identity
  (network [value]
    (stack-slot :identity value)))
(define stack-graph
  (network [value]
    (stack-slot :graph value)))
(define stack-expansions
  (network [value]
    (stack-slot :expansions value)))
(define expansion-source
  (network [value]
    (stack-slot :source value)))
(define expansion-target
  (network [value]
    (stack-slot :target value)))
