;; Requires structure.lain and traversal-state.lain. All reads are qualified by
;; the frozen observation; no operation may fall back to a newer live runtime.
;; Frozen readers are versioned definitions in the primitive implementation
;; slot. Every reader remains observation-qualified. A direct expansion retains
;; the compound node that owns each lower plane.

(define expand-pending
  (network [observation state]
    (let-cell [empty? result]
      (-> (traversal-empty? state) empty?)
      (when (switch true empty?)
        (-> (finish-traversal state) result))
      (when (switch true (not empty?))
        (let-cell [step work remaining occurrence identity discovered? next
                   graph expansions registered connected]
          (-> (take-pending state) step)
          (-> (pending-work step) work)
          (-> (pending-remaining step) remaining)
          (-> (pending-occurrence work) occurrence)
          (-> (occurrence-identity observation occurrence) identity)
          (-> (discovered-occurrence? remaining identity) discovered?)

          ;; Known occurrences connect through explicit references and are never
          ;; expanded twice. Registration precedes child discovery for cycles.
          (when (switch true discovered?)
            (-> (connect-reference remaining work identity) next))
          (when (switch true (not discovered?))
            (-> (content-of-scope observation occurrence) graph)
            (-> (direct-compound-expansions observation occurrence) expansions)
            (-> (register-occurrence remaining work identity graph) registered)
            (-> (connect-expansion-outputs registered identity expansions) connected)
            (-> (enqueue-expansion-work connected identity expansions) next))

          ;; Construction and scheduling precede this tail-position loop call.
          (-> (expand-pending observation next) result)))
      result)))

(define scope->stack
  (network [observation root]
    (let [initial (begin-traversal observation root)
          completed (expand-pending observation initial)]
      (traversal-result completed))))

;; Primary declarative entry: expand this traced compound node into a spatial
;; stack. All returned values are implicit; conditional branches are selected
;; as zero-argument networks and the recursive call remains in tail position.
(define compound->stack
  (network [observation compound-node]
    (let-cell [occurrence]
      (-> (compound-occurrence observation compound-node) occurrence)
      (scope->stack observation occurrence))))

;; Convenience discovery requires unique, complete root-membership evidence.
(define hierarchy->stacks
  (network [observation]
    (let-cell [root]
      (-> (root-compound-node observation) root)
      (compound->stack observation root))))
