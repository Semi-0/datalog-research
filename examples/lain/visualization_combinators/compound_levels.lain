;; Outer chain: 2 -> stage -> 9 -> pipeline -> 10201.
;; A stage is shift followed by square; a pipeline contains two stages.
;; Explicit occurrence identity, not a definition shared by all calls.
;; The second argument gates these snapshots on completed computation.
;; Generic higher-order transformations: references remain attached to their cells.
;; Existing retained-syntax tracer. "potential" means declared in the body;
;; "call" means realized application. These are not runtime dataflow edges.
;; Outer chain, pipeline body, stage body, cell references, cell values, call IR.

(define shift
  (network [x]
    (+ x 1)))

(define square
  (network [x]
    (* x x)))

(define stage
  (network [x out]
    (-> (square (shift x)) out)
    (list out)))

(define pipeline
  (network [x out]
    (let-cell [middle]
      (stage x middle)
      (stage middle out))
    (list out)))

(define source)

(define prepared)

(define result)

(define relationships)

(define whole-chain)

(stage source prepared)

(pipeline prepared result)

(-> 2 source)

(relationship:roots source relationships)

(relationship:dataflow relationships whole-chain)

(define stage-body
  (body-snapshot (occurrence-of stage source prepared) result))

(define pipeline-body
  (body-snapshot (occurrence-of pipeline prepared result) result))

(define child-cells
  (filter (network [item] (cell-ref? item)) stage-body))

(define child-list
  (transpose child-cells :list))

(define child-values
  (map (network [item] (strongest-of item)) child-list))

(define compiled-calls
  (call-graph stage))

(xr:io (juxtapose whole-chain pipeline-body stage-body child-list child-values compiled-calls))
