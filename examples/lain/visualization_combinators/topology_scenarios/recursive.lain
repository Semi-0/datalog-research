(define down
  (network [a out]
    (when (switch true (<= a 1))
      (-> a out))
    (when (switch true (> a 1))
      (down (- a 1) out))
    (list out)))

(define input)

(define result)

(define other)

(define unused)

(define raw)

(define semantic)

(down input result)

(down other unused)

(relationship:roots input raw)

(relationship:dataflow raw semantic)
