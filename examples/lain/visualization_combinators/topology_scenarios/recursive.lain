(define down
  (network [a]
    (let-cell [out]
      (when (switch true (<= a 1))
        (-> a out))
      (when (switch true (> a 1))
        (-> (down (- a 1)) out))
      out)))

(define input (let-cell [port] port))

(define other (let-cell [port] port))

(define result (down input))

(define unused (down other))

(define raw (relationship:roots input))

(define semantic (relationship:dataflow raw))
