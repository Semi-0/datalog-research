;; Functions, compounds, repeated nested calls, and an unrelated sibling chain.

(define shift
  (network [x]
    (+ x 1)))

(define square
  (network [x]
    (* x x)))

(define stage
  (network [x]
    (square (shift x))))

(define pipeline
  (network [x]
    (stage (stage x))))

(define source (let-cell [port] port))

(define other (let-cell [port] port))

(define prepared (shift source))

(define left (stage prepared))

(define result (pipeline left))

(define unused (stage other))

(define raw (relationship:roots source))

(define semantic (relationship:dataflow raw))
