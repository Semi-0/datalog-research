    {
      "task": {
        "id": "events",
        "namespace": "benchmark.event-projection",
        "function": "project-events",
        "args": "initial events",
        "path": "benchmark/event_projection.clj",
        "test_namespace": "benchmark.event-projection-test",
        "test_path": "test/benchmark/event_projection_test.clj",
        "acceptance": "events-acceptance.clj",
        "description": "Implement project-events. initial must be a Clojure map, otherwise throw ex-info with :type :invalid-state. Reduce a finite collection of event VECTORS into the final map: [:put key value] associates any value; [:delete key] removes it, missing key is a no-op; [:increment key delta] adds integer delta to an existing integer value, treating an ABSENT key as zero. A present nil or false is not absent and cannot be incremented. Keys may be nil, false or structured. Event operations and arities must match exactly. Reject non-vectors, unknown operations, wrong arities, noninteger deltas, and incrementing noninteger existing values using ex-info with {:type :invalid-event :index i :event event}, where i is the zero-based index of the first invalid event. nil events means no events. Support finite lazy event sequences. Do not mutate initial/events or add dependencies. Acceptance includes 100000 increment events."
      },
      "expected_assertions": 42,
      "evaluator_sha256": "9cfae63ff9d9d2ad1c292e31ff27cdd951b259c07e670aae3f5d7fb4bb9627d3",
