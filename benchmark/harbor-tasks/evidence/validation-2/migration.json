    {
      "task": {
        "id": "order",
        "namespace": "benchmark.dependency-order",
        "function": "dependency-order",
        "args": "nodes edges",
        "path": "benchmark/dependency_order.clj",
        "test_namespace": "benchmark.dependency-order-test",
        "test_path": "test/benchmark/dependency_order_test.clj",
        "acceptance": "order-acceptance.clj",
        "description": "Implement dependency-order. nodes is a vector of distinct Clojure values, including possibly nil, false, maps or vectors. edges is a vector of [before after] pairs. Return a vector containing all nodes exactly once with every before preceding its after. At each step choose the earliest node in the ORIGINAL nodes vector among ALL currently ready nodes, including newly ready nodes. For example nodes [:a :b :c :d] and edges [[:c :a]] returns [:b :c :a :d]. Duplicate edges count once. For an endpoint not present in nodes throw ex-info with :type :unknown-node. For any cycle, including a self-cycle or a disconnected cycle, throw ex-info with :type :cycle. Empty input returns []. Do not mutate inputs or add dependencies. Acceptance includes a 10000-node chain; avoid quadratic scans."
      },
      "expected_assertions": 17,
      "evaluator_sha256": "b85175ffdce75616bd39c1081a2b7ce74665b185994b48677925f245b094a93d",
      "source_commit": "85010635cf887cf5e3eba1179b5181a5c31ed389",
