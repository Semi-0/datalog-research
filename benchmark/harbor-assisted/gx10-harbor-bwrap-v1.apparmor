# SPDX-License-Identifier: Apache-2.0
# Based on Moby's container AppArmor policy. Namespace/mount exceptions are
# selected only for this named pilot profile; no unconfined flag is used.
# https://github.com/moby/profiles/blob/4b8214fc4971e06172938a1f1554ccff6647ee80/apparmor/template.go
abi <abi/4.0>,
include <tunables/global>

profile gx10-harbor-bwrap-v1 flags=(attach_disconnected,mediate_deleted) {
  include <abstractions/base>
  network,
  network unix,
  deny network alg,
  deny network vsock,
  capability,
  file,
  userns,
  mount,
  umount,
  pivot_root,

  signal (receive) peer=unconfined,
  signal (receive) peer=runc,
  signal (receive) peer=crun,
  signal (send,receive) peer=gx10-harbor-bwrap-v1,
  ptrace (trace,tracedby,read,readby) peer=gx10-harbor-bwrap-v1,

  deny @{PROC}/* w,
  deny @{PROC}/{[^1-9/],[^1-9/][^0-9/],[^1-9s/][^0-9y/][^0-9s/],[^1-9/][^0-9/][^0-9/][^0-9/]*}/** w,
  deny @{PROC}/sys/[^k]** w,
  deny @{PROC}/sys/kernel/{?,??,[^s][^h][^m]**} w,
  deny @{PROC}/sysrq-trigger rwklx,
  deny @{PROC}/kcore rwklx,
  deny /sys/[^f]*/** wklx,
  deny /sys/f[^s]*/** wklx,
  deny /sys/fs/[^c]*/** wklx,
  deny /sys/fs/c[^g]*/** wklx,
  deny /sys/fs/cg[^r]*/** wklx,
  deny /sys/firmware/** rwklx,
  deny /sys/devices/virtual/powercap/** rwklx,
  deny /sys/kernel/security/** rwklx,
}
