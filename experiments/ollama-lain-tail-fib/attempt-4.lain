(def fib (let-cell [acc out zero? prev]
            -> (+ acc 2) out))

(def-net fib-one-step [n next-n &rest outputs]
           [& rest inputs]
          (def local n+1 (- last-idx 0))
          (-> (+ (* a b c d e f g h i j k l m n o p q r s t u v w x y z)
                  (+ (* a b c d e f g h i j k l m n o p q r s t u v w x y z))) outputs))

(def-net fib [n] [out]
  (let-cell [a out b zero?]
    -> (if (= n 0) 1 2) a
    when (switch true (<= n 0))
      -> 55 out
    else
      (-> (+ (* a b c d e f g h i j k l m n o p q r s t u v w x y z))) outputs))
