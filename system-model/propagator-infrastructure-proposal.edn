 :supported-by [:evidence/propagator-recursion :evidence/propagator-compiler]
 :verification "Inspect public GUR exports and compiler declaration dependencies; run flat application/idempotence contract tests and flag documentation that names a different canonical default."}

{:type :constraint
 :id :constraint/propagator-runtime-gc
 :text "Decouple garbage collection from propagator semantics and merge by composing it as a host-runtime extension. Keep root discovery, collection policy and scheduling outside propagator structures and the core scheduler. Collect only at explicitly safe runtime boundaries accounting for pending tasks, queued commits, subscriptions and in-flight effect references."
 :created-at #inst "2026-10-18T09:34:18.000Z"
 :scope "Host runtime lifecycle"
 :source "user-instruction:2026-10-18"
 :status :active :lifecycle :candidate :evidence-state :needs-verification
 :applies-to [:component/propagator-host :component/propagator-kernel]
 :supported-by [:evidence/propagator-host]
 :verification "Review runtime-extension ownership and root contracts; when a collector exists, test idle eligibility, in-flight roots and semantic equivalence with collection disabled. Existing sources describe lifecycle requirements; they do not establish a completed collector or extension API."}

{:type :constraint
 :id :constraint/propagator-session-extension
 :text "Use immutable session-extension declarations to install primitive propagator bindings and side-effect capabilities per session. A session owns its bindings, fixed handler registrations and effect ledger. Installing an extension must not change another session or globally redefine capabilities; effect handlers run at the host boundary, never inside propagation."
 :created-at #inst "2026-10-18T09:34:18.000Z"
 :scope "Host runtime / compiler environment extension"
 :source "user-instruction:2026-10-18"
 :status :active :lifecycle :candidate :evidence-state :needs-verification
 :applies-to [:component/propagator-host :component/propagator-compiler]
 :supported-by [:evidence/propagator-session-extension]
 :verification "Run session-extension tests for immutable declarations, repeated-install idempotence, conflicting identities, fixed handlers, primitive bindings and isolation of independently created sessions."}

{:type :constraint
 :id :constraint/propagator-immutable-structure
 :text "Propagator structures must remain immutable declarations of their name and activation behavior. Do not mutate fields or capture mutable domain/runtime state whose changes alter the same declaration meaning. Put execution cursors, queues, communication state and lifecycle state in explicit runner/runtime extensions; make semantic updates new values or declared messages."
 :created-at #inst "2026-10-18T09:34:18.000Z"
 :scope "Kernel propagator representation / execution extensions"
 :source "user-instruction:2026-10-18"
 :status :active :lifecycle :candidate :evidence-state :needs-verification
 :applies-to [:component/propagator-kernel :component/propagator-host :component/propagator-recursion]
 :supported-by [:evidence/propagator-kernel :evidence/propagator-runner-extension]
 :verification "Inspect constructors, activation composition and state capture; compare installed propagator declarations before/after execution and test that composed wrappers do not mutate the original structure. Persistent record fields alone do not prove captured activation state is immutable."}

